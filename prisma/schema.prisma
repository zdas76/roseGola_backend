generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id           Int           @id @default(autoincrement())
  categoryName String        @unique @db.VarChar(200)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subCategory  SubCategory[]

  @@map("categoris")
}

model SubCategory {
  id              Int       @id @default(autoincrement())
  subCategoryName String    @unique @db.VarChar(200)
  categoryId      Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product[]
  category        Category  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("sub_categoris")
}

model Unit {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(20)
  createdAt        DateTime          @default(now())
  updateAt         DateTime          @updatedAt
  packingMaterials PackingMaterial[]
  Product          Product[]
  RawMaterial      RawMaterial[]

  @@map("units")
}

model AccountHead {
  id           Int            @id @default(autoincrement())
  headName     String
  headId       String         @unique @db.VarChar(2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  accountsItem AccountsItem[]

  @@map("account_head")
}

model AccountsItem {
  id               Int         @id @default(autoincrement())
  accountsItemName String
  accountHeadId    String      @db.VarChar(2)
  accountsItemId   String      @db.VarChar(6)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  accountHead      AccountHead @relation(fields: [accountHeadId], references: [headId])
  journal          Journal[]

  @@index([accountHeadId], map: "account_items_accountHeadId_fkey")
  @@map("account_items")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(30)
  password  String
  name      String   @db.VarChar(50)
  phone     String   @db.VarChar(14)
  role      UserRole @default(USER)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("user")
}

model Employee {
  id           Int       @id @default(autoincrement())
  email        String?   @unique @db.VarChar(30)
  name         String    @db.VarChar(50)
  nid          String?   @db.VarChar(20)
  dob          DateTime? @db.Date
  workingPlase String?
  photo        String?
  address      String
  mobile       String    @db.VarChar(14)
  status       Status    @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@map("employees")
}

model Party {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(50)
  contactNo          String              @db.VarChar(15)
  address            String              @db.VarChar(200)
  partyType          PartyType
  openingDate        DateTime?           @default(now())
  openingAmount      Float?              @default(0)
  isDeleted          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchaseOrderInfos PurchaseOrderInfo[]
  transactionInfos   TransactionInfo[]

  @@map("parties")
}

model Product {
  id                       Int                      @id @default(autoincrement())
  name                     String                   @db.VarChar(100)
  description              String                   @db.VarChar(250)
  subCategoryId            Int
  minPrice                 Int?
  size                     String?
  quantity                 Float
  unitPrice                Float
  alertQuantity            Int                      @default(0)
  unitId                   Int
  openingDate              DateTime
  openingAmount            Float
  isDeleted                Boolean                  @default(false)
  status                   Status                   @default(ACTIVE)
  createdAt                DateTime                 @default(now())
  updateAt                 DateTime                 @updatedAt
  inventory                Inventory[]
  productioniteminfo       productioniteminfo[]
  subCategory              SubCategory              @relation(fields: [subCategoryId], references: [id])
  unit                     Unit                     @relation(fields: [unitId], references: [id])
  purchaseOrderInventories PurchaseOrderInventory[]

  @@index([subCategoryId, name])
  @@index([unitId], map: "products_unitId_fkey")
  @@map("products")
}

model RawMaterial {
  id                       Int                      @id @default(autoincrement())
  name                     String                   @db.VarChar(50)
  unitId                   Int
  description              String?                  @db.VarChar(250)
  openingDate              DateTime
  openingAmount            Float
  quantity                 Float
  alertQuantity            Int                      @default(0)
  unitPrice                Float
  isDeleted                Boolean                  @default(false)
  status                   Status                   @default(ACTIVE)
  createdAt                DateTime                 @default(now())
  updateAt                 DateTime                 @updatedAt
  inventory                Inventory[]
  productRawMaterial       IngredientRawMaterial[]
  purchaseOrderInventories PurchaseOrderInventory[]
  unit                     Unit                     @relation(fields: [unitId], references: [id])

  @@index([unitId], map: "raw_materials_unitId_fkey")
  @@map("raw_materials")
}

model PackingMaterial {
  id                         Int                         @id @default(autoincrement())
  name                       String                      @db.VarChar(50)
  unitId                     Int
  description                String?                     @db.VarChar(250)
  openingDate                DateTime
  quantity                   Float
  alertQuantity              Int                         @default(0)
  openingAmount              Float
  unitPrice                  Float
  isDeleted                  Boolean                     @default(false)
  status                     Status                      @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updateAt                   DateTime                    @updatedAt
  inventory                  Inventory[]
  unit                       Unit                        @relation(fields: [unitId], references: [id])
  pminventories              PMInventory[]
  ingredientPackingMaterials IngredientPackingMaterial[]
  purchaseOrderInventories   PurchaseOrderInventory[]

  @@index([unitId], map: "packing_materials_unitId_fkey")
  @@map("packing_materials")
}

model PurchaseOrderInfo {
  id            Int                      @id @default(autoincrement())
  orderNo       String                   @unique
  date          DateTime?                @default(now())
  partyId       Int?
  status        Status                   @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  party         Party?                   @relation(fields: [partyId], references: [id])
  purchaseOrder PurchaseOrderInventory[]

  @@index([orderNo, partyId])
  @@index([partyId])
  @@map("purchase_order_info")
}

model PurchaseOrderInventory {
  id                Int               @id @default(autoincrement())
  purchaseOrderId   Int
  productId         Int?
  rawId             Int?
  unitPrice         Float             @default(0)
  quantity          Float             @default(0)
  amount            Float?            @default(0)
  status            Status            @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  packingMaterialId Int?
  packingMaterial   PackingMaterial?  @relation(fields: [packingMaterialId], references: [id])
  product           Product?          @relation(fields: [productId], references: [id])
  purchaseOrder     PurchaseOrderInfo @relation(fields: [purchaseOrderId], references: [id])
  raWMaterial       RawMaterial?      @relation(fields: [rawId], references: [id])

  @@index([purchaseOrderId, rawId])
  @@index([purchaseOrderId, productId])
  @@index([productId])
  @@index([rawId])
  @@index([packingMaterialId], map: "purchase_order_inventory_packingMaterialId_fkey")
  @@map("purchase_order_inventory")
}

model BankAccount {
  id              Int               @id @default(autoincrement())
  bankName        String
  branceName      String?
  accountNumber   String
  status          Status            @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bankTransaction BankTransaction[]

  @@unique([bankName, accountNumber])
  @@map("bank_accounts")
}

model BankTransaction {
  id              Int              @id @default(autoincrement())
  date            DateTime
  bankAccountId   Int
  transectionId   Int?
  debitAmount     Int?
  creditAmount    Int?
  isClosing       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id])
  transactionInfo TransactionInfo? @relation(fields: [transectionId], references: [id])

  @@index([bankAccountId], map: "bank_transactions_bankAccountId_fkey")
  @@index([transectionId], map: "bank_transactions_transectionId_fkey")
  @@map("bank_transactions")
}

model Inventory {
  id                     Int              @id @default(autoincrement())
  date                   DateTime
  productId              Int?
  rawId                  Int?
  transactionId          Int?
  department             Department
  unitPrice              Float            @default(0)
  integratedUnitPrice    Float            @default(0)
  quantityAdd            Float?           @default(0)
  quantityLess           Float?           @default(0)
  discount               Float?           @default(0)
  debitAmount            Float?           @default(0)
  creditAmount           Float?           @default(0)
  integratedDebitAmount  Float?           @default(0)
  integratedCreditAmount Float?           @default(0)
  isOpening              Boolean          @default(false)
  status                 Status           @default(PENDING)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  packingMaterialId      Int?
  packingMaterial        PackingMaterial? @relation(fields: [packingMaterialId], references: [id])
  product                Product?         @relation(fields: [productId], references: [id])
  raWMaterial            RawMaterial?     @relation(fields: [rawId], references: [id])
  transactionInfo        TransactionInfo? @relation(fields: [transactionId], references: [id])

  @@index([productId, transactionId])
  @@index([rawId])
  @@index([packingMaterialId], map: "inventories_packingMaterialId_fkey")
  @@index([transactionId], map: "inventories_transactionId_fkey")
  @@map("inventories")
}

model PMInventory {
  id                     Int              @id @default(autoincrement())
  date                   DateTime
  packingMaterialId      Int
  transactionId          Int?
  department             Department
  perUnitQty             Float?           @default(0)
  perUnitCost            Float?           @default(0)
  unitPrice              Float            @default(0)
  integratedUnitPrice    Float            @default(0)
  quantityAdd            Float?           @default(0)
  quantityLess           Float?           @default(0)
  discount               Float?           @default(0)
  debitAmount            Float?           @default(0)
  creditAmount           Float?           @default(0)
  integratedDebitAmount  Float?           @default(0)
  integratedCreditAmount Float?           @default(0)
  isOpening              Int              @default(0)
  status                 Status           @default(PENDING)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  packingMaterial        PackingMaterial  @relation(fields: [packingMaterialId], references: [id])
  transactionInfo        TransactionInfo? @relation(fields: [transactionId], references: [id])

  @@index([packingMaterialId], map: "pm_inventories_packingMaterialId_fkey")
  @@index([transactionId], map: "pm_inventories_transactionId_fkey")
  @@map("pm_inventories")
}

model TransactionInfo {
  id                          Int                           @id @default(autoincrement())
  voucherNo                   String                        @unique
  invoiceNo                   String?
  date                        DateTime?                     @default(now())
  partyId                     Int?
  voucherType                 VoucherType
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  bankTransaction             BankTransaction[]
  inventory                   Inventory[]
  journal                     Journal[]
  pminventories               PMInventory[]
  productionExpensesInventory ProductionExpensesInventory[]
  productioniteminfo          productioniteminfo?
  party                       Party?                        @relation(fields: [partyId], references: [id])

  @@index([voucherNo, voucherType, partyId])
  @@index([partyId], map: "transaction_info_partyId_fkey")
  @@map("transaction_info")
}

model Journal {
  id                     Int              @id @default(autoincrement())
  transectionId          Int?
  accountsItemId         Int?
  date                   DateTime         @db.Date
  checkOrRTGS            Float?           @default(0)
  creditAmount           Float?           @default(0)
  debitAmount            Float?           @default(0)
  integratedDebitAmount  Float?           @default(0)
  integratedCreditAmount Float?           @default(0)
  narration              String?
  isClosing              Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  accountsItem           AccountsItem?    @relation(fields: [accountsItemId], references: [id])
  transactionInfo        TransactionInfo? @relation(fields: [transectionId], references: [id])

  @@index([accountsItemId])
  @@index([transectionId], map: "journals_transectionId_fkey")
  @@map("journals")
}

model ProductionIngradient {
  id                        Int                         @id @default(autoincrement())
  productId                 Int
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  ingredientExpneseItems    IngredientExpneseItems[]
  ingredientRawMaterials    IngredientRawMaterial[]
  ingredientPackingMaterial IngredientPackingMaterial[]

  @@map("product_ingradients")
}

model IngredientRawMaterial {
  id                     Int                  @id @default(autoincrement())
  productionIngradientId Int
  rawId                  Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  productIngradient      ProductionIngradient @relation(fields: [productionIngradientId], references: [id])
  rawMaterials           RawMaterial          @relation(fields: [rawId], references: [id])

  @@index([productionIngradientId], map: "product_raw_materials_productionIngradientId_fkey")
  @@index([rawId], map: "product_raw_materials_rawId_fkey")
  @@map("product_raw_materials")
}

model IngredientPackingMaterial {
  id                     Int                  @id @default(autoincrement())
  productionIngradientId Int
  packingMaterialId      Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  packingMaterial        PackingMaterial      @relation(fields: [packingMaterialId], references: [id])
  productionIngradient   ProductionIngradient @relation(fields: [productionIngradientId], references: [id])

  @@index([packingMaterialId], map: "production_packing_materials_packingMaterialId_fkey")
  @@index([productionIngradientId], map: "production_packing_materials_productionIngradientId_fkey")
  @@map("production_packing_materials")
}

model IngredientExpneseItems {
  id                      Int                   @id @default(autoincrement())
  productionIngradientId  Int
  productionExpenssItemId Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  productionExpenseItem   productionexpenseitem @relation(fields: [productionExpenssItemId], references: [id])
  productIngradient       ProductionIngradient  @relation(fields: [productionIngradientId], references: [id])

  @@index([productionExpenssItemId], map: "ingredient_expnese_productionExpenssItemId_fkey")
  @@index([productionIngradientId], map: "ingredient_expnese_productionIngradientId_fkey")
  @@map("ingredient_expnese")
}

model ProductionExpensesInventory {
  id                    Int                   @id @default(autoincrement())
  date                  DateTime
  proExpencesItemId     Int
  transectionId         Int?
  unitRate              Float                 @default(0)
  expDuration           Float                 @default(0)
  amount                Float                 @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  productionExpenseItem productionexpenseitem @relation(fields: [proExpencesItemId], references: [id])
  transactionInfo       TransactionInfo?      @relation(fields: [transectionId], references: [id])

  @@index([proExpencesItemId], map: "production_expences_inventory_proExpencesItemId_fkey")
  @@index([transectionId], map: "production_expences_inventory_transectionId_fkey")
  @@map("production_expences_inventory")
}

model productionexpenseitem {
  id                            Int                           @id @default(autoincrement())
  expItemName                   String
  unitRate                      Float                         @default(0)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  ingredientExpneseItems        IngredientExpneseItems[]
  productionExpensesInventories ProductionExpensesInventory[]
}

model productioniteminfo {
  id               Int                       @id @default(autoincrement())
  transactionId    Int                       @unique(map: "ProductionItemInfo_transactionId_key")
  productId        Int
  batchNo          String                    @unique(map: "ProductionItemInfo_batchNo_key") @db.VarChar(50)
  status           productioniteminfo_status @default(PROCESSING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  products         Product                   @relation(fields: [productId], references: [id], map: "ProductionItemInfo_productId_fkey")
  transaction_info TransactionInfo           @relation(fields: [transactionId], references: [id], map: "ProductionItemInfo_transactionId_fkey")

  @@index([productId], map: "ProductionItemInfo_productId_fkey")
}

enum Department {
  PURCHASE
  PRODUCTION
  RM_STORE
  MP_STORE
  FG_STORE
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
  CONTRA
  PRODUCTION
  REQUISITION
  FINISH_GOODS
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum Status {
  ACTIVE
  DELETED
  PUSH
  BLOCK
  PENDING
}

enum PartyType {
  VENDOR
  CUSTOMER
  SUPPLIER
  DISTRIBUTOR
}

enum productioniteminfo_status {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETE
  DELETE
}
